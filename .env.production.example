# ============================================
# CONTOH .env PRODUKSI (aaPanel)
# Cara pakai: copy file ini menjadi ".env" di server,
# lalu isi bagian BERTANDA <-- ISI.
# ============================================

APP_NAME="Absensi Guru"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://domain-anda.com # <-- ISI (tanpa trailing slash)
APP_KEY= # <-- OTOMATIS via "php artisan key:generate", biarkan kosong

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ---- Database MySQL (buat dulu di menu Database aaPanel) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=guru_presensi # <-- ISI
DB_USERNAME=guru_presensi # <-- ISI
DB_PASSWORD=xxxxxxxx      # <-- ISI password user DB

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@domain-anda.com" # <-- ISI (opsional)
MAIL_FROM_NAME="${APP_NAME}"
